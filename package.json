{
    "name": "signalk-flags",
    "version": "1.1.2",
    "description": "Country Flags plugin for Signal K server.",
    "main": "plugin/index.js",
    "signalk": {
        "displayName": "Flag Icons",
        "appIcon": "./app-icon.svg"
    },
    "keywords": [
        "signalk",
        "signalk-node-server-plugin",
        "signalk-category-utility"
    ],
    "repository": "https://github.com/panaaj/signalk-flags",
    "author": "AdrianP",
    "license": "Apache-20",
    "scripts": {
        "build": "tsc",
        "build-declaration": "tsc --declaration --allowJs false",
        "watch": "npm run build -- -w",
        "test": "mocha",
        "start": "npm run build -- -w",
        "format": "prettier --write src/*",
        "prepublishOnly": "tsc",
        "prepack": "tsc"
    },
    "dependencies": {
        "@signalk/server-api": "^2.30.0",
        "flag-icons": "^7.3.2"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "prettier": "^3.8.4",
        "typescript": "^6.0.3"
    },
    "signalk-plugin-enabled-by-default": true
}
